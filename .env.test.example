# Copy to `.env.test` to run the test suite locally:
#   cp .env.test.example .env.test
#   docker compose up -d postgres-test
#   pnpm test
# The DATABASE_URL must contain "test" — global-setup refuses to run
# migrations (and the suite refuses to truncate) against any other database.
DATABASE_URL="postgresql://ctfrbt:ctfrbt@localhost:5434/ctfrbt_test"
NEXTAUTH_SECRET="test-secret"
NEXTAUTH_URL="http://localhost:3000"

# Demo URLs for the libpq backup unit tests (synthetic credentials only).
# LIBPQ_TEST_URL_ENCODED has a percent-encoded password; LIBPQ_TEST_URL_RAW
# the same password unencoded, exercising the percentDecode fallback.
LIBPQ_TEST_URL_ENCODED="postgresql://demo_user:Pa%26ss%25w%40rd@db.local:5432/demo_db"
LIBPQ_TEST_URL_RAW="postgresql://demo_user:Pa&ss%w@db.local:5432/demo_db"
